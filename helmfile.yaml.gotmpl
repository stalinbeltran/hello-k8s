# Helmfile: describe QUÉ releases de Helm deben existir y con QUÉ valores,
# por entorno. Un solo comando instala/actualiza todo:
#   helmfile -e dev apply
#   helmfile -e prod apply
#
# La extensión .gotmpl permite usar plantillas de Go en este archivo
# (ojo: se procesan incluso dentro de los comentarios).

environments:
  dev: {}
  prod: {}

---

repositories:
  - name: ingress-nginx
    url: https://kubernetes.github.io/ingress-nginx

releases:
  # ── COMPARTIDO DEL CLÚSTER ──────────────────────────────────────────────
  # Uno solo para todos los entornos: nombre y namespace fijos (sin el entorno).
  # Aplicarlo desde dev o prod da el mismo resultado.
  - name: ingress-nginx
    namespace: ingress-nginx
    createNamespace: true
    chart: ingress-nginx/ingress-nginx
    version: 4.15.1                 # versión fija: todos instalan lo mismo
    labels:
      tier: cluster
    values:
      - cluster/ingress-nginx.yaml

  # ── PROPIO DE CADA ENTORNO ──────────────────────────────────────────────
  - name: hello
    namespace: hello-{{ .Environment.Name }}   # un namespace por entorno
    createNamespace: true
    chart: ./charts/hello
    labels:
      tier: app
    needs:
      - ingress-nginx/ingress-nginx  # instalar primero el controller
    values:
      - environments/{{ .Environment.Name }}/hello.yaml   # valores propios del entorno
